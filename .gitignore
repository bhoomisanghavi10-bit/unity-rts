*.app

# Crashlytics
crashlytics-build.properties

# Packages (lockfile is kept, cache is not)
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# OS files
.DS_Store
Thumbs.db
